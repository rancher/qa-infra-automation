# Containerised runner for the dashboard-e2e playbook.
# Includes ansible, tofu, helm, kubectl and all required collections
# so users only need Docker (or Podman) on the host.
#
# Multi-arch: builds natively on both amd64 and arm64 (Apple Silicon).
#
# Build:  docker build -f Dockerfile.quickstart -t dashboard-e2e-runner .
# Run:    see run.sh

# The base image is held on the 3.12 line on purpose. The uv install below caps
# ansible-core below 2.17, and 2.16's supported control-node Pythons stop at
# 3.12, so the two move together or not at all. See docs/architecture.md for
# what raising the cap involves.
# renovate: datasource=docker depName=python
FROM python:3.12-alpine3.23@sha256:31a768b01976652c222e318fe5bd6e7c252f056cbf489c88fa256f1bf0af58e3

ARG TARGETARCH

# renovate: datasource=github-release-attachments depName=opentofu/opentofu
ARG TOFU_VERSION=v1.12.6
# renovate: datasource=github-release-attachments depName=opentofu/opentofu digestVersion=v1.12.6
ARG TOFU_SUM_AMD64=5dc43da4f750f33873dc25e94587128709e819e544b7be9016b255316153c3a8
ARG TOFU_SUM_ARM64=e573979ba68a17fe7b881752051a694a7efcd970e39521f6a25775197861ed4d

# Held on helm 3, which is current: 3.21.4 shipped the day after 4.2.4. Do not
# take Renovate's v4 bump. See docs/architecture.md, "Helm is held on the 3
# series".
# renovate: datasource=github-release-attachments depName=helm/helm
ARG HELM_VERSION=v3.21.4
# renovate: datasource=github-release-attachments depName=helm/helm digestVersion=v3.21.4
ARG HELM_SUM_AMD64=61f88ab166748cb19604d7884cb100ae9ccb13804ddeb98e08af167eacbb6a14
ARG HELM_SUM_ARM64=b54c04b4e0b2540bbdc08c17a121dab70e9a2ed0de5705528fec68a5fd3b85a7

# renovate: datasource=github-release-attachments depName=kubernetes/kubernetes
ARG KUBECTL_VERSION=v1.37.0
# renovate: datasource=github-release-attachments depName=kubernetes/kubernetes digestVersion=v1.37.0
ARG KUBECTL_SUM_AMD64=6129359f4e1f3848a5572ccb0b26cf28b8ca08cef38c95a765b2f64a2c961a2f
ARG KUBECTL_SUM_ARM64=922df28df248cc00a9e025f947704f1d1482de64ece54cfe57e61f19eaf1eef3

# renovate: datasource=github-release-attachments depName=astral-sh/uv
ARG UV_VERSION=0.12.5
# renovate: datasource=github-release-attachments depName=astral-sh/uv digestVersion=0.12.5
ARG UV_SUM_AMD64=a4742988791c9aeae68c78150d6cba762062ad2a47e53738c2779d2b596bfcdb
ARG UV_SUM_ARM64=8767a0e77f2cd45436401b1b42bf7e9ed5a4a91a74a5305d6fe93249d0f6dbc5

RUN apk add --no-cache \
      git curl unzip xxd openssh-client docker-cli gcompat \
    && chmod 666 /etc/passwd /etc/group

# uv (uses x86_64/aarch64 naming)
# Fallback to uname when TARGETARCH is unset (legacy builder without BuildKit)
RUN ARCH="${TARGETARCH:-$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')}" \
    && case "${ARCH}" in \
         amd64) UV_ARCH="x86_64"; UV_SUM="${UV_SUM_AMD64}" ;; \
         arm64) UV_ARCH="aarch64"; UV_SUM="${UV_SUM_ARM64}" ;; \
         *) echo "Unsupported arch: ${ARCH}" >&2; exit 1 ;; \
       esac \
    && curl -fsSL "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-${UV_ARCH}-unknown-linux-musl.tar.gz" \
         -o /tmp/uv.tar.gz \
    && echo "${UV_SUM}  /tmp/uv.tar.gz" | sha256sum -c - \
    && tar -xz --strip-components=1 -C /usr/local/bin "uv-${UV_ARCH}-unknown-linux-musl/uv" < /tmp/uv.tar.gz \
    && rm /tmp/uv.tar.gz

RUN uv pip install --system --no-cache \
      "ansible-core<2.17" ansible kubernetes docker

# Pinned to match the ansible-core cap above: community.docker 5+ and
# community.crypto 3+ both require ansible-core 2.17 or newer. These are the
# reason the cap cannot be raised on its own.
#
# Installed to the system path, not the default ~/.ansible: run.sh runs the
# container with HOME=/tmp so artifacts stay host-owned, and a collection under
# /root is then invisible. /usr/share/ansible/collections is searched whatever
# HOME is set to, so the same image works under run.sh and under Jenkins.
RUN ansible-galaxy collection install \
      -p /usr/share/ansible/collections \
      cloud.terraform kubernetes.core \
      "community.docker:<5" "community.crypto:<3" --upgrade

# OpenTofu
RUN ARCH="${TARGETARCH:-$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')}" \
    && case "${ARCH}" in \
         amd64) TOFU_SUM="${TOFU_SUM_AMD64}" ;; \
         arm64) TOFU_SUM="${TOFU_SUM_ARM64}" ;; \
         *) echo "Unsupported arch: ${ARCH}" >&2; exit 1 ;; \
       esac \
    && curl -fsSL "https://github.com/opentofu/opentofu/releases/download/${TOFU_VERSION}/tofu_${TOFU_VERSION#v}_linux_${ARCH}.zip" \
         -o /tmp/tofu.zip \
    && echo "${TOFU_SUM}  /tmp/tofu.zip" | sha256sum -c - \
    && unzip -o /tmp/tofu.zip -d /usr/local/bin tofu \
    && rm /tmp/tofu.zip \
    && chmod +x /usr/local/bin/tofu \
    && ln -sf /usr/local/bin/tofu /usr/local/bin/terraform

# Helm
RUN ARCH="${TARGETARCH:-$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')}" \
    && case "${ARCH}" in \
         amd64) HELM_SUM="${HELM_SUM_AMD64}" ;; \
         arm64) HELM_SUM="${HELM_SUM_ARM64}" ;; \
         *) echo "Unsupported arch: ${ARCH}" >&2; exit 1 ;; \
       esac \
    && curl -fsSL "https://get.helm.sh/helm-${HELM_VERSION}-linux-${ARCH}.tar.gz" \
         -o /tmp/helm.tar.gz \
    && echo "${HELM_SUM}  /tmp/helm.tar.gz" | sha256sum -c - \
    && tar -xz --strip-components=1 -C /usr/local/bin "linux-${ARCH}/helm" < /tmp/helm.tar.gz \
    && rm /tmp/helm.tar.gz

# kubectl
RUN ARCH="${TARGETARCH:-$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')}" \
    && case "${ARCH}" in \
         amd64) KUBECTL_SUM="${KUBECTL_SUM_AMD64}" ;; \
         arm64) KUBECTL_SUM="${KUBECTL_SUM_ARM64}" ;; \
         *) echo "Unsupported arch: ${ARCH}" >&2; exit 1 ;; \
       esac \
    && curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${ARCH}/kubectl" \
         -o /usr/local/bin/kubectl \
    && echo "${KUBECTL_SUM}  /usr/local/bin/kubectl" | sha256sum -c - \
    && chmod +x /usr/local/bin/kubectl

WORKDIR /playbook
COPY . .

# Entrypoint wrapper: registers non-root UIDs (e.g. macOS 501) dynamically in /etc/passwd
COPY <<-"EOF" /entrypoint.sh
#!/bin/sh
set -e
if ! getent passwd "$(id -u)" >/dev/null 2>&1; then
    echo "user:x:$(id -u):$(id -g):user:${HOME:-/tmp}:/bin/sh" >> /etc/passwd
fi
exec "$@"
EOF

RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh", "ansible-playbook", "dashboard-e2e-playbook.yml"]
