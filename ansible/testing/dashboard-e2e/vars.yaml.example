# =============================================================================
# Dashboard E2E Test Pipeline Variable Configuration
# =============================================================================
# Copy to vars.yaml and adjust values for your environment.
# Jenkins sets most of these via environment variables; the playbook falls back
# to these defaults when running manually.
# =============================================================================

# --- AWS infrastructure ---
aws_region: "us-west-1"
aws_ssh_user: "ubuntu"
aws_instance_type: "t3a.xlarge"
aws_volume_size: 60
aws_volume_type: "gp3"
aws_ami: "ami-xxxxxxxxxxxxxxxxx"
aws_security_group: "sg-xxxxxxxxxxxxxxxxx"
aws_subnet: "subnet-xxxxxxxxxxxxxxxxx"
aws_vpc: "vpc-xxxxxxxxxxxxxxxxx"
aws_route53_zone: "example.your-domain.com"

# --- K3s ---
k3s_kubernetes_version: "v1.30.0+k3s1"
server_count: 3

# --- Rancher ---
rancher_helm_repo: "rancher-com-rc"
rancher_image_tag: "v2.14-head"
cert_manager_version: "1.11.0"
bootstrap_password: "password"
rancher_password: "password1234"
rancher_username: "admin"
# Pin the UI to the one the Rancher image embeds. Leave unset for the Rancher
# default, which on a release branch `-head` tag serves the branch's UI from
# releases.rancher.com; the image itself embeds the last GA UI, so pinning
# would test a current backend against a weeks old UI. Set to "true" when a run
# needs to be repeatable and the branch's UI is not what is under test, for
# example when validating a change to the tests themselves.
# ui_offline_preferred: "true"

# --- Test-runner pinned versions ---
# Keep in sync with: https://github.com/cypress-io/cypress-docker-images/blob/master/factory/.env
cypress_version: "15.19.0"
nodejs_version: "24.14.0"
yarn_version: "1.22.22"
chrome_version: "146.0.7680.164-1"

# --- Dashboard repo ---
dashboard_repo: "rancher/dashboard"
dashboard_branch: "master"
# dashboard_overlay_branch: "master"

# --- Cypress ---
# Tags still filter tests at runtime when using --spec. To run everything in a
# spec, leave this empty (adjustment yields exclusion-only tags) or use
# "@bypass" to also drop the automatic prime/noVai exclusions.
cypress_tags: "@adminUser"
allow_filtered_catalog_skip: true  # When true (default), chart tests may skip if the chart is filtered out of the UI catalog. Set false to fail instead.
cypress_browser: "chrome"     # Use "electron" on Apple Silicon (arm64), Chrome requires amd64
job_type: "recurring"              # recurring | existing
create_initial_clusters: true
# rancher_host: ""                 # Required for job_type=existing

# --- Reporting ---
percy_enabled: false
qase_enabled: false
qase_project: "RM"
# qase_debug: false
