# renovate: datasource=docker depName=cypress/factory
FROM cypress/factory:8.4.0@sha256:949eca692b414848576bd3b21d6df42cf393dff62d5b5b3954b60c4e7b03c41b

# Provided automatically by BuildKit; falls back to dpkg on legacy builders.
ARG TARGETARCH

# renovate: datasource=github-release-attachments depName=kubernetes/kubernetes
ENV KUBECTL_VERSION=v1.37.0
# renovate: datasource=github-release-attachments depName=kubernetes/kubernetes digestVersion=v1.33.10
ENV KUBECTL_SUM_AMD64=f156acb753ee4366789ab7a663916eb580e7ee1b9e449bc9b052181db524e3f5
ENV KUBECTL_SUM_ARM64=e9494229893ccddc81065275c0e5f21167518ab939f0e95aecb649fb4b41c112

# Install kubectl for the build architecture. amd64 (Linux CI) and arm64
# (Apple Silicon) are both verified against their pinned checksum.
RUN ARCH="${TARGETARCH:-$(dpkg --print-architecture)}" && \
    case "${ARCH}" in \
      amd64) KUBECTL_SUM="${KUBECTL_SUM_AMD64}" ;; \
      arm64) KUBECTL_SUM="${KUBECTL_SUM_ARM64}" ;; \
      *) echo "Unsupported arch: ${ARCH}" >&2; exit 1 ;; \
    esac && \
    wget -q "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${ARCH}/kubectl" -O /tmp/kubectl && \
    echo "${KUBECTL_SUM}  /tmp/kubectl" | sha256sum -c - && \
    mv /tmp/kubectl /bin/kubectl && \
    chmod +x /bin/kubectl

# curl is required by the imported-cluster registration command
# (`curl --insecure -sfL <manifest> | kubectl apply -f -`) executed by
# cypress/e2e/tests/pages/manager/cluster-manager.spec.ts.
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /root/.kube

# `COPY --chmod` is a BuildKit-only flag and the Jenkins agents build with the
# legacy builder, so the mode is set in a separate step that both builders
# accept. Mode 644 is required because local runs start the container with
# `--user`, and that non-root user has to read the kubeconfig.
COPY imported_config /root/.kube/config
RUN chmod 644 /root/.kube/config

# Berry branches run yarn@4 via corepack (cypress.sh). Pin the corepack that
# Node 24 ships, matching the dashboard PR; classic branches keep Yarn 1.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# renovate: datasource=npm depName=corepack
ENV COREPACK_VERSION=0.34.6
RUN npm install -g "corepack@${COREPACK_VERSION}"

ENTRYPOINT ["bash", "cypress/jenkins/cypress.sh"]
