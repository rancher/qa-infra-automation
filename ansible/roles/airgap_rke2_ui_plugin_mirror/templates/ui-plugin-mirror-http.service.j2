[Unit]
Description=Dumb-HTTP mirror for rancher/ui-plugin-charts (airgap UI extensions)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=python3 -m http.server {{ ui_plugin_mirror_port }} --bind {{ ui_plugin_mirror_listen }} --directory {{ ui_plugin_mirror_dest | dirname }}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
