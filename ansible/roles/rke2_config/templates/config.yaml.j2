# RKE2 configuration file
# Generated by Ansible - rke2_config role
# Node: {{ inventory_hostname }}
# Role: {{ rke2_node_role }}

{% set _cni = _rke2_effective_cni | default(rke2_cni | default('')) %}
{% set _acfg = _rke2_effective_additional_config | default(rke2_additional_config | default({})) %}
{% set _scfg = _rke2_effective_server_config | default(rke2_server_config | default({})) %}
{% set _token = rke2_token | default(rke2_config_existing_token | default('')) %}
{% if rke2_node_role == 'master' or 'cp' in node_roles or 'etcd' in node_roles %}
# Server node configuration
{% if _cni | length > 0 %}
cni: {{ _cni }}
{% endif %}
{% for key, value in _scfg.items() %}
{% if value is string %}
{{ key }}: {{ value | to_json }}
{% elif value is sequence and value is not string %}
{{ key }}:
{% for item in value %}
  - {{ item }}
{% endfor %}
{% if key == 'tls-san' %}
  - {{ ansible_host }}
{% if rke2_node_role == 'master' %}
{% for host in groups.get('servers', []) %}
  - {{ hostvars[host]['ansible_host'] }}
{% endfor %}
{% endif %}
{% endif %}
{% elif value is mapping %}
{{ key }}:
{% for subkey, subvalue in value.items() %}
  {{ subkey }}: {{ subvalue }}
{% endfor %}
{% else %}
{{ key }}: {{ value }}
{% endif %}
{% endfor %}

{% if rke2_server_flags | default({}) | length > 0 %}
# Additional server node configurations
{% for key, value in (rke2_server_flags | default({})).items() %}
{% if value is string %}
{{ key }}: {{ value }}
{% elif value is sequence and value is not string %}
{{ key }}:
{% for item in value %}
  - {{ item }}
{% endfor %}
{% else %}
{{ key }}: {{ value }}
{% endif %}
{% endfor %}
{% endif %}

{% if rke2_node_role != 'master' %}
# Join to existing cluster
server: https://{% if ':' in kube_api_host and '[' not in kube_api_host %}[{{ kube_api_host }}]{% else %}{{ kube_api_host }}{% endif %}:9345
{% endif %}

{% if _token != '' %}
token: {{ _token | to_json }}
{% endif %}

{% else %}
# Agent node configuration
# Join to existing cluster
server: https://{% if ':' in kube_api_host and '[' not in kube_api_host %}[{{ kube_api_host }}]{% else %}{{ kube_api_host }}{% endif %}:9345

{% for key, value in (rke2_agent_config | default({})).items() %}
{% if key != 'server' %}
{% if value is string %}
{{ key }}: {{ value | to_json }}
{% elif value is sequence and value is not string %}
{{ key }}:
{% for item in value %}
  - {{ item }}
{% endfor %}
{% else %}
{{ key }}: {{ value }}
{% endif %}
{% endif %}
{% endfor %}

{% if rke2_worker_flags | default({}) | length > 0 %}
# Additional agent node configurations
{% for key, value in (rke2_worker_flags | default({})).items() %}
{% if value is string %}
{{ key }}: {{ value }}
{% elif value is sequence and value is not string %}
{{ key }}:
{% for item in value %}
  - {{ item }}
{% endfor %}
{% else %}
{{ key }}: {{ value }}
{% endif %}
{% endfor %}
{% endif %}

{% if _token != '' %}
token: {{ _token | to_json }}
{% endif %}
{% endif %}

{% if rke2_disable_components | default([]) | length > 0 %}
# Disabled components
disable:
{% for component in (rke2_disable_components | default([])) %}
  - {{ component }}
{% endfor %}
{% endif %}

{% if _acfg | length > 0 %}
# Additional configuration.
# External datastore: pass `datastore-endpoint: <conn-string>` here (or via
# server flags). RKE2 switches to kine automatically when it's set — no explicit
# etcd-disable is needed. The connection string's case/colons are preserved.
{{ _acfg | to_nice_yaml(indent=2, sort_keys=false) | trim }}
{% endif %}
