# RKE2 Windows agent configuration file
# Generated by Ansible - rke2_windows_agent role
# Node: {{ inventory_hostname }}
# Role: agent (Windows supports no other type)

server: https://{{ kube_api_host }}:9345
token: {{ rke2_token }}

node-label:
  - role-worker=true
{% for label in rke2_windows_node_labels %}
  - {{ label }}
{% endfor %}

{% if rke2_windows_node_ip %}
node-ip: {{ rke2_windows_node_ip }}
{% endif %}
{% if rke2_windows_additional_config | length > 0 %}
# Additional configuration
{{ rke2_windows_additional_config | to_nice_yaml(indent=2, sort_keys=false) | trim }}
{% endif %}
