      "os": "linux"
    },
    {
      "name": "windows-worker-0",
      "roles": ["worker"],
      "public_ip": "1.2.3.6",
      "private_ip": "10.0.1.3",
      "os": "windows",
      "ssh_user": "Administrator"
    }
  ]
